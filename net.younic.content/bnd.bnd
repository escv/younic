-buildpath: \
	osgi.annotation;version=latest,\
	osgi.cmpn;version=latest,\
	net.younic.core.api;version=latest,\
	com.github.rjeschke.txtmark,\
	org.jsoup;version='1.14'

-testpath: \
	${junit},\
	org.jmock:jmock; version=2.8.2,\
	org.jmock:jmock-junit4; version=2.8.2

javac.source: 21
javac.target: 21

Bundle-Version: 0.0.0.${tstamp}
Private-Package: net.younic.content.internal
Export-Package: net.younic.content